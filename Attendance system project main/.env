# Database Configuration
DB_NAME=attendance_system_db
DB_USER=postgres
DB_PASSWORD=@Jaatboy9811
DB_HOST=localhost
DB_PORT=5432

# Face Recognition Thresholds
FACE_STRICT_THRESHOLD=0.48
FACE_MIN_SIZE=60
FACE_AMBIGUITY_MARGIN=0.03
FACE_TOP_K=3
FACE_PREDICTION_BUFFER=5
FACE_CONFIRM_FRAMES=3
FACE_MAX_MISSES=8
FACE_UNKNOWN_LOG_COOLDOWN=3

# PERFORMANCE OPTIMIZATIONS FOR LOW-END DEVICES
# Process every Nth frame (3 = process every 3rd frame, improves FPS 3x)
# Higher = Better FPS, Lower = More responsive detection
FRAME_SKIP=3

# Resolution scale for face detection (0.4 = 40% of original)
# Lower = Better FPS, Higher = Better accuracy
# Recommended: 0.35-0.4 for low-end, 0.5 for high-end devices
FACE_DETECTION_SCALE=0.4

# Face upsampling (0 = faster/fewer small faces detected, 1+ = slower/more thorough)
# 0 = Fastest, 1 = Medium, 2 = Slowest but most thorough
FACE_DETECTION_UPSAMPLE=1

# Enable model caching (greatly improves performance)
# Set to 'true' or 'false'
MODEL_CACHE_ENABLED=true
RENDER=true
SECRET_KEY=super-secret-key-123